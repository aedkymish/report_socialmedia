DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SUPERUSER_USERNAME=A900
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_TIME_ZONE=Africa/Tripoli
EVIDENCE_ASYNC=1
# Update yt-dlp to the latest version on every container start (1/0)
YTDLP_AUTO_UPDATE=1
EVIDENCE_MAX_VIDEO_MB=500
# Seconds to wait for profile content (video thumbnails) before the screenshot
EVIDENCE_CONTENT_WAIT_SECONDS=30
# "قائمة فيديوهات الحساب" image: auto (only when the grid is missing) | always | never
EVIDENCE_VIDEOS_SHEET=auto
# Login cookies: just drop the exported file into the ./cookies/ folder (picked up automatically).
# Only set this to force a specific file inside the container:
# YTDLP_COOKIES_FILE=/app/cookies/cookies.txt

# Organisation logo in the PDF report header (put the file in ./branding/)
REPORT_LOGO_PATH=branding/logo.png
# Logo height in pixels (optional)
REPORT_LOGO_HEIGHT=70
# Logo watermark on every printed page (1/0) and its strength (0.02 - 0.3)
REPORT_WATERMARK=1
REPORT_WATERMARK_OPACITY=0.07
# Text under the watermark logo (leave empty for the logo only)
REPORT_WATERMARK_TEXT=فريق الرصد والمتابعة الإلكترونية

# Fixed code of the platform contact point (form section 5, item 3)
PLATFORM_CONTACT_CODE=003
