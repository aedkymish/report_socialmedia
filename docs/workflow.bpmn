<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_ActionRequest" targetNamespace="http://example.local/report_socialmedia">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="P_Team" name="فريق الرصد والمتابعة الإلكترونية" processRef="Proc_ActionRequest"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_ActionRequest" name="طلب إجراء (حجب - قفل - حظر - توثيق)" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="L_Monitor" name="مسؤول الرصد"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Fill</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_System" name="النظام (Django)"><bpmn:flowNodeRef>T_Analyze</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Video</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Download</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Join</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Screenshot</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Approver" name="المسؤول المعتمد (مكتب الأدلة الرقمية)"><bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="حالة مرصودة"/>
    <bpmn:userTask id="T_Fill" name="تعبئة النموذج: المنصات، الإجراء، الروابط، السبب، أكواد المخولين"/>
    <bpmn:serviceTask id="T_Analyze" name="تحليل كل رابط (المنصة / منشور أم صفحة)">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true"/>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Video" name="فيديو؟"/>
    <bpmn:serviceTask id="T_Download" name="تحميل الفيديو وتخزينه + SHA-256"/>
    <bpmn:exclusiveGateway id="GW_Join"/>
    <bpmn:serviceTask id="T_Screenshot" name="تصوير الصفحة الشخصية + SHA-256"/>
    <bpmn:userTask id="T_Review" name="مراجعة الطلب والأدلة"/>
    <bpmn:exclusiveGateway id="GW_Decision" name="القرار"/>
    <bpmn:endEvent id="End_Approved" name="معتمد (توقيع + تاريخ)"/>
    <bpmn:endEvent id="End_Rejected" name="مرفوض"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Fill"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T_Fill" targetRef="T_Analyze"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T_Analyze" targetRef="GW_Video"/>
    <bpmn:sequenceFlow id="F4" name="نعم" sourceRef="GW_Video" targetRef="T_Download"/>
    <bpmn:sequenceFlow id="F5" name="لا" sourceRef="GW_Video" targetRef="GW_Join"/>
    <bpmn:sequenceFlow id="F6" sourceRef="T_Download" targetRef="GW_Join"/>
    <bpmn:sequenceFlow id="F7" sourceRef="GW_Join" targetRef="T_Screenshot"/>
    <bpmn:sequenceFlow id="F8" sourceRef="T_Screenshot" targetRef="T_Review"/>
    <bpmn:sequenceFlow id="F9" sourceRef="T_Review" targetRef="GW_Decision"/>
    <bpmn:sequenceFlow id="F10" name="اعتماد" sourceRef="GW_Decision" targetRef="End_Approved"/>
    <bpmn:sequenceFlow id="F11" name="رفض" sourceRef="GW_Decision" targetRef="End_Rejected"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="S_P" bpmnElement="P_Team" isHorizontal="true"><dc:Bounds x="0" y="0" width="1300" height="450"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L1" bpmnElement="L_Monitor" isHorizontal="true"><dc:Bounds x="30" y="0" width="1270" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L2" bpmnElement="L_System" isHorizontal="true"><dc:Bounds x="30" y="130" width="1270" height="170"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L3" bpmnElement="L_Approver" isHorizontal="true"><dc:Bounds x="30" y="300" width="1270" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start" bpmnElement="Start"><dc:Bounds x="80" y="47" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Fill" bpmnElement="T_Fill"><dc:Bounds x="160" y="25" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_An" bpmnElement="T_Analyze"><dc:Bounds x="330" y="175" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GV" bpmnElement="GW_Video" isMarkerVisible="true"><dc:Bounds x="495" y="190" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_DL" bpmnElement="T_Download"><dc:Bounds x="580" y="140" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GJ" bpmnElement="GW_Join" isMarkerVisible="true"><dc:Bounds x="745" y="190" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_SS" bpmnElement="T_Screenshot"><dc:Bounds x="830" y="175" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_RV" bpmnElement="T_Review"><dc:Bounds x="830" y="335" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GD" bpmnElement="GW_Decision" isMarkerVisible="true"><dc:Bounds x="1000" y="350" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EA" bpmnElement="End_Approved"><dc:Bounds x="1110" y="317" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_ER" bpmnElement="End_Rejected"><dc:Bounds x="1110" y="397" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E1" bpmnElement="F1"><di:waypoint x="116" y="65"/><di:waypoint x="160" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="F2"><di:waypoint x="300" y="65"/><di:waypoint x="395" y="65"/><di:waypoint x="395" y="175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="F3"><di:waypoint x="460" y="215"/><di:waypoint x="495" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="F4"><di:waypoint x="520" y="190"/><di:waypoint x="520" y="175"/><di:waypoint x="580" y="175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="F5"><di:waypoint x="520" y="240"/><di:waypoint x="520" y="275"/><di:waypoint x="770" y="275"/><di:waypoint x="770" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="F6"><di:waypoint x="710" y="175"/><di:waypoint x="770" y="175"/><di:waypoint x="770" y="190"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="F7"><di:waypoint x="795" y="215"/><di:waypoint x="830" y="215"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E8" bpmnElement="F8"><di:waypoint x="895" y="255"/><di:waypoint x="895" y="335"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E9" bpmnElement="F9"><di:waypoint x="960" y="375"/><di:waypoint x="1000" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E10" bpmnElement="F10"><di:waypoint x="1025" y="350"/><di:waypoint x="1025" y="335"/><di:waypoint x="1110" y="335"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E11" bpmnElement="F11"><di:waypoint x="1025" y="400"/><di:waypoint x="1025" y="415"/><di:waypoint x="1110" y="415"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
